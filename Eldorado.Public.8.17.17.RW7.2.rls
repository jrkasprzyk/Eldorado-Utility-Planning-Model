    END
    UUID "{433c7b91-4816-4aa2-a4b7-78316c7fb70b}";;

    RULE                 "XResToRes1PhysicalExchangeTransferToRes1Reusable";
    DESCRIPTION          "";
    ACTIVE               TRUE;
    RULE_EXEC_CONSTRAINT TRUE;
