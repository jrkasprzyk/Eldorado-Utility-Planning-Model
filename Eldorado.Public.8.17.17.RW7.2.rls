    BEGIN

      IF_STATEMENT ($ "UtilityExchanges.GravelPitOnOff" [] != 1.00000000) THEN
            $ "GravelPitDiv UtilityReusable to GravelPitDivObj UtilityReusable Div.Supply" [] := 0.00000000 "cfs";

